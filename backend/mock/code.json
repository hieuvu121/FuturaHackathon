      "def deliver_with_retry(job, attempts=3):",
      "    for attempt in range(attempts):",
      "        try:",
      "            send_notification(job)",
      "            job.mark_delivered()",
      "            return True",
      "        except Exception:",
      "            pass",
      "    job.mark_failed()",
      "    return False",
