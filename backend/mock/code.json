    "lines":[
      "@router.post(\"/checkout\")",
      "async def checkout(payload: CheckoutRequest, user=Depends(current_user)):",
      "    order = Order(user_id=user.id, items=payload.items)",
      "    for item in payload.items:",
      "        if not inventory.available(item.sku, item.quantity):",
      "            raise HTTPException(409, \"Insufficient stock\")",
      "    order, applied = apply_discounts(order, user, payload.codes)",
      "    await inventory.reserve(payload.items)",
      "    await orders.commit(order)",
      "    await notifications.enqueue_receipt(order.id)",
      "    return CheckoutResponse(",
      "        order_id=order.id, total=order.total, promotions=applied",
      "    )",
