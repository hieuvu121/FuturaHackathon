    "lines":[
      "def apply_discounts(order, user, codes):",
      "    total = order.subtotal",
      "    applied = []",
      "    for code in codes:",
      "        promo = PROMOS.get(code)",
      "        if promo and promo.active:",
      "            if promo.kind == \"percent\":",
      "                if user.tier == \"gold\" or total > 200:",
      "                    total -= total * promo.value / 100",
      "                    applied.append(code)",
      "            elif promo.kind == \"fixed\":",
      "                if total - promo.value > 0:",
      "                    total -= promo.value",
      "                    applied.append(code)",
      "    if user.tier == \"gold\" and not applied:",
      "        total *= 0.95",
      "    order.total = round(total, 2)",
      "    return order, applied"
    ]
  },
  {
