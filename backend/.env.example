# Copy to .env and fill in. .env is gitignored; this file is not.

# --- GitHub OAuth (github.com/settings/developers -> New OAuth App) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=change-me-before-demo

# --- LLM ---
LLM_PROVIDER=openai        # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SCANNER_MODEL=gpt-5
GENERATOR_MODEL=claude-sonnet-5
GRADER_MODEL=claude-sonnet-5

# --- Ingest ---
TARGET_LANGUAGE=python
CLONE_DEPTH=200
MAX_REPO_MB=200
ENABLE_BLAME=false
SCAN_FILE_LIMIT=25

# --- Knowledge sources: swap implementations without touching code ---
TAXONOMY_SOURCE=seeded     # seeded | external
LADDER_SOURCE=seeded       # seeded | external

# The roadmap's demand source of truth is STILL UNDECIDED -- see plan.md §10.
# "chained" defers the decision: each source below is tried in order and the
# first one to answer wins, so scraped data can land incrementally while the
# LLM estimate and the seeded table cover the gaps. Nobody is blocked.
#   seeded  -- hand-written table, always answers, lowest fidelity
#   scraped -- data/market.json from collected job ads, highest fidelity
#   llm     -- model estimate, labelled ESTIMATED with confidence <= 0.4
#
# Demo decision (plan.md §10.1): DEMAND_SOURCE=llm feeds Learn New only. It uses
# LLM_PROVIDER and its key above, makes one call per role/region, and caches the
# answer in cache/demand_llm/ (delete the file to re-estimate). If the key or
# provider fails, Learn New is empty and Revise/Deepen still render.
# Rehearsed fallbacks: DEMAND_SOURCE=seeded, then MOCK_MODE=true.
# "scraped" and "chained" are not implemented yet -- do not enable them.
DEMAND_SOURCE=seeded       # seeded | llm
DEMAND_CHAIN=["scraped","llm","seeded"]

# --- Modes ---
# MOCK_MODE=true serves backend/mock/*.json from every endpoint.
# Leave it true until your track's real implementation is merged.
MOCK_MODE=true
